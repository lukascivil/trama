---
import Logo from './Logo.astro';
import Terminal from './Terminal.astro';
import Weave from './Weave.astro';
import { copy, links, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const other = lang === 'en' ? `${base}/pt/` : `${base}/`;

// Code samples whose words follow the page's language.
const s =
  lang === 'pt'
    ? {
        prompt: 'renomear message para greeting no GET /hello',
        impact: [
          'trama-demo-web lê message em src/api/hello.ts:15 → quebra',
          'ordem segura: api adiciona greeting → web lê greeting → api remove message',
        ],
        actions: ['adiciona greeting, mantém message', 'lê greeting', 'remove message'],
        org: 'sua-empresa',
        shared: '(compartilhado)',
      }
    : {
        prompt: 'rename message to greeting in GET /hello',
        impact: [
          'trama-demo-web reads message at src/api/hello.ts:15 → breaking',
          'safe order: api adds greeting → web reads greeting → api removes message',
        ],
        actions: ['add greeting, keep message', 'read greeting', 'remove message'],
        org: 'your-org',
        shared: '(shared)',
      };

const pillarCode = [
  {
    title: 'catalog/trama-demo-web.yaml',
    plain: true,
    code: `consumes:
  - kind: http
    id: GET /hello
    from: trama-demo-api
    via: env
    evidence:
      - src/api/hello.ts:10
      - src/api/hello.ts:15`,
  },
  {
    title: 'trama up',
    plain: false,
    code: `$ trama up
trama-demo-api | listening on http://localhost:8080
trama-demo-web | ➜ Local: http://localhost:5173/`,
  },
  {
    title: 'Claude Code',
    plain: false,
    code: `> /trama:impact ${s.prompt}
${s.impact.join('\n')}`,
  },
  {
    title: 'changes/2026-10-31-rename-message-to-greeting.md',
    plain: true,
    code: [
      ['1', 'open', 'trama-demo-api', s.actions[0]],
      ['2', 'open · draft', 'trama-demo-web', s.actions[1]],
      ['3', 'pending', 'trama-demo-api', s.actions[2]],
    ]
      .map(([n, state, repo, action]) => `${n}  ${state.padEnd(13)}${repo}\n   ${action}`)
      .join('\n'),
  },
];

const strategyCode = [
  `acme/
├── workspace.yaml
└── repos/
    ├── web
    ├── mobile
    ├── gateway
    ├── orders-api
    ├── auth
    └── billing`,
  `payments/
└── repos/
    ├── checkout-web
    ├── payments-api
    ├── gateway  ${s.shared}
    └── auth     ${s.shared}
identity/
└── repos/
    ├── login-web
    ├── identity-api
    ├── gateway  ${s.shared}
    └── auth     ${s.shared}`,
];

const startCode = [
  '/plugin marketplace add lukascivil/trama\n/plugin install trama@trama',
  '/trama:init',
  `/trama:add-repo https://github.com/${s.org}/web\n/trama:add-repo https://github.com/${s.org}/api`,
  '$ mise exec -- trama up',
  `/trama:impact "${s.prompt}"\n/trama:change "${s.prompt}"`,
  '$ trama sync\n$ trama changes\n/trama:map --all',
];

const unknownCode = `consumes:
  - kind: http
    id: GET /orders
    from: unknown
    candidates: [orders-api, legacy-orders]`;

const requirements = [
  ['git', 'https://git-scm.com'],
  ['GitHub CLI', links.gh],
  ['mise', links.mise],
  ['Claude Code', links.claude],
];
---

<header class="site-header">
  <div class="container header-row">
    <a class="brand" href={lang === 'en' ? `${base}/` : `${base}/pt/`} aria-label="trama">
      <Logo />
      <span>trama</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="#problem">{t.nav.problem}</a>
      <a href="#how">{t.nav.how}</a>
      <a href="#strategies">{t.nav.strategies}</a>
      <a href="#start">{t.nav.start}</a>
      <a href="#faq">{t.nav.faq}</a>
    </nav>
    <div class="header-actions">
      <a class="lang" href={other} hreflang={lang === 'en' ? 'pt-BR' : 'en'}>{t.nav.language}</a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label={t.nav.theme} title={t.nav.theme}>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <a class="icon-btn" href={links.repo} aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="gh">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<main>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>
          {t.hero.title}
          <span>{t.hero.titleAccent}</span>
        </h1>
        <p class="hero-lead">{t.hero.lead}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#start">{t.hero.primary} <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={links.repo}>{t.hero.secondary}</a>
        </div>
        <p class="hero-note">{t.hero.note}</p>
        <div class="hero-install">
          <Terminal
            title={t.hero.installTitle}
            code={startCode[0]}
            copy={t.copy}
            copied={t.copied}
          />
        </div>
      </div>
      <div class="hero-art">
        <Weave />
      </div>
    </div>
  </section>

  <section id="problem" class="section">
    <div class="container two-col">
      <div>
        <p class="kicker">{t.problem.kicker}</p>
        <h2 class="section-title">{t.problem.title}</h2>
        <p class="section-lead">{t.problem.lead}</p>
      </div>
      <div>
        <ol class="plumbing">
          {t.problem.steps.map((step) => <li>{step}</li>)}
        </ol>
        <p class="problem-outro">{t.problem.outro}</p>
      </div>
    </div>
  </section>

  <section id="solution" class="section soft">
    <div class="container two-col">
      <div>
        <p class="kicker">{t.solution.kicker}</p>
        <h2 class="section-title">{t.solution.title}</h2>
        <p class="section-lead">{t.solution.lead}</p>
        <ul class="points">
          {
            t.solution.points.map(([title, text]) => (
              <li>
                <strong>{title}</strong>
                <span>{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="tree-card" aria-label="my-workspace/">
        <div class="tree-head"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>my-workspace/</div>
        <ul class="tree">
          {
            t.solution.tree.map(([name, text], i) => (
              <li>
                <code>
                  <span class="branch">{i === t.solution.tree.length - 1 ? '└──' : '├──'}</span> {name}
                </code>
                <span>{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="how" class="section">
    <div class="container">
      <p class="kicker">{t.how.kicker}</p>
      <h2 class="section-title">{t.how.title}</h2>
      <div class="pillars">
        {
          t.how.pillars.map((p, i) => (
            <article class="pillar">
              <div class="pillar-head">
                <span class="pillar-n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{p.name}</h3>
                <code class="chip">{p.command}</code>
              </div>
              <p>{p.text}</p>
              <Terminal title={pillarCode[i].title} code={pillarCode[i].code} plain={pillarCode[i].plain} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="relations" class="section soft">
    <div class="container two-col">
      <div>
        <p class="kicker">{t.relations.kicker}</p>
        <h2 class="section-title">{t.relations.title}</h2>
        <p class="section-lead">{t.relations.lead}</p>
        <div class="unknown">
          <p>{t.relations.unknown}</p>
          <Terminal title="catalog/web.yaml" code={unknownCode} plain />
        </div>
      </div>
      <ul class="kinds">
        {
          t.relations.kinds.map(([name, text]) => (
            <li>
              <strong>{name}</strong>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="strategies" class="section">
    <div class="container">
      <p class="kicker">{t.strategies.kicker}</p>
      <h2 class="section-title">{t.strategies.title}</h2>
      <p class="section-lead">{t.strategies.lead}</p>
      <div class="strategies">
        {
          t.strategies.options.map((o, i) => (
            <article class="strategy">
              <h3>{o.name}</h3>
              <p>{o.text}</p>
              <Terminal code={strategyCode[i]} plain title={i === 0 ? 'acme/' : 'payments/ · identity/'} />
              <p class="best">{o.best}</p>
            </article>
          ))
        }
      </div>
      <p class="tip">{t.strategies.tip}</p>
    </div>
  </section>

  <section id="start" class="section soft">
    <div class="container">
      <p class="kicker">{t.start.kicker}</p>
      <h2 class="section-title">{t.start.title}</h2>
      <div class="reqs">
        <span>{t.start.requirements}</span>
        {requirements.map(([name, href]) => <a href={href}>{name}</a>)}
      </div>
      <ol class="steps">
        {
          t.start.steps.map((step, i) => (
            <li>
              <div class="step-copy">
                <span class="step-n">{i + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.where}</p>
                </div>
              </div>
              <Terminal code={startCode[i]} copy={t.copy} copied={t.copied} />
            </li>
          ))
        }
      </ol>
      <div class="demo">
        <div>
          <h3>{t.start.demoTitle}</h3>
          <p>{t.start.demoText}</p>
        </div>
        <div class="demo-links">
          <a class="btn btn-ghost" href={links.demo}>{t.start.demoWorkspace}</a>
          <a class="btn btn-ghost" href={links.record}>{t.start.demoRecord}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="origin" class="section">
    <div class="container origin">
      <p class="kicker">{t.origin.kicker}</p>
      <h2 class="section-title">{t.origin.title}</h2>
      <p class="section-lead">{t.origin.text}</p>
      <a class="text-link" href={links.metaharness}>{t.origin.link} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="faq" class="section soft">
    <div class="container faq-grid">
      <div>
        <p class="kicker">{t.faq.kicker}</p>
        <h2 class="section-title">{t.faq.title}</h2>
      </div>
      <div class="faq">
        {
          t.faq.items.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="container footer-row">
    <div class="brand">
      <Logo size={22} />
      <span>trama</span>
      <span class="footer-tagline">{t.footer.tagline}</span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={links.repo}>GitHub</a>
      <a href={links.releases}>{t.footer.releases}</a>
      <a href={links.demo}>{t.footer.demo}</a>
      <a href={`${links.repo}/blob/main/LICENSE`}>{t.footer.license}</a>
      <a href={other} hreflang={lang === 'en' ? 'pt-BR' : 'en'}>{t.nav.language}</a>
    </nav>
  </div>
</footer>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('trama-theme', next);
    } catch {}
  });

  // Copies with the Clipboard API, or with a hidden textarea where that API
  // is not allowed.
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.term-copy').forEach((button) => {
    button.addEventListener('click', async () => {
      if (await copyText(button.dataset.copy ?? '')) {
        button.textContent = button.dataset.done ?? '';
        setTimeout(() => (button.textContent = button.dataset.label ?? ''), 1600);
      }
    });
  });
</script>

<style>
  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 700 19px/1 var(--sans);
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 22px;
    margin-left: 12px;
  }
  .nav a,
  .lang {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }
  .nav a:hover,
  .lang:hover {
    color: var(--text);
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .lang {
    margin-right: 6px;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .icon-btn:hover {
    border-color: var(--border);
    background: var(--bg-elev);
  }
  .icon-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .icon-btn svg.gh {
    fill: currentColor;
    stroke: none;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  @media (max-width: 860px) {
    .nav {
      display: none;
    }
  }

  /* Hero */
  .hero {
    padding: 72px 0 96px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .eyebrow {
    display: inline-block;
    font: 600 13px/1 var(--mono);
    color: var(--thread-b);
    padding: 7px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    margin-bottom: 24px;
  }
  h1 {
    font-size: clamp(38px, 5.6vw, 64px);
    font-weight: 750;
    letter-spacing: -0.035em;
  }
  h1 span {
    display: block;
    color: var(--accent-text);
  }
  .hero-lead {
    margin-top: 22px;
    font-size: 18.5px;
    color: var(--muted);
    max-width: 58ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .hero-note {
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .hero-install {
    margin-top: 28px;
    max-width: 480px;
  }
  .hero-art {
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--bg-elev);
    padding: 12px;
    box-shadow: var(--shadow);
  }
  @media (max-width: 900px) {
    .hero {
      padding: 48px 0 72px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Shared layouts */
  .soft {
    background: var(--bg-soft);
  }
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }

  /* Problem */
  .plumbing {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: 10px;
  }
  .plumbing li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: start;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-elev);
    font-weight: 500;
  }
  .plumbing li::before {
    content: counter(step, decimal-leading-zero);
    font: 600 13px/1.9 var(--mono);
    color: var(--thread-a);
  }
  .problem-outro {
    margin-top: 22px;
    color: var(--muted);
  }

  /* Solution */
  .points {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .points li {
    display: grid;
    gap: 2px;
    padding-left: 18px;
    border-left: 2px solid var(--thread-b);
  }
  .points span {
    color: var(--muted);
  }
  .tree-card {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .tree-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-border);
    font: 600 13px/1 var(--mono);
    color: var(--code-text);
  }
  .dots {
    display: inline-flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3f4b;
  }
  .tree {
    list-style: none;
    margin: 0;
    padding: 14px 18px 18px;
    display: grid;
    gap: 12px;
  }
  .tree li {
    display: grid;
    grid-template-columns: minmax(170px, auto) 1fr;
    gap: 4px 16px;
    align-items: baseline;
  }
  .tree code {
    color: var(--code-text);
    font-size: 13.5px;
    white-space: nowrap;
  }
  .tree .branch {
    color: var(--code-comment);
  }
  .tree li > span {
    color: var(--code-muted);
    font-size: 14px;
  }
  @media (max-width: 520px) {
    .tree li {
      grid-template-columns: 1fr;
    }
    .tree li > span {
      padding-left: 34px;
    }
  }

  /* How it works */
  .pillars {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .pillar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-elev);
  }
  .pillar > p {
    color: var(--muted);
    flex: 1;
  }
  .pillar-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pillar-n {
    font: 600 13px/1 var(--mono);
    color: var(--thread-a);
  }
  .pillar h3 {
    font-size: 22px;
  }
